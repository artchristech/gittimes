GITHUB_TOKEN=ghp_your_token_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
# Optional: override the OpenRouter model (default: nvidia/nemotron-3-super-120b-a12b:free)
LLM_MODEL=
CHAT_WORKER_URL=
# Set to "true" to enable X sentiment badges (opt-in; needs an x_search-capable provider, not OpenRouter)
X_SENTIMENT=
# Plausible Analytics domain (e.g. "gittimes.com") — leave empty to disable
PLAUSIBLE_DOMAIN=
# Your Lineup (gittimes lineup sync): the account session to push your build history with.
# Prefer `gittimes lineup login --token …` (stores it in ~/.config/gittimes/session); this env var overrides it.
GITTIMES_SESSION=
# Worker the CLI syncs to; falls back to CHAT_WORKER_URL when empty.
GITTIMES_WORKER_URL=
